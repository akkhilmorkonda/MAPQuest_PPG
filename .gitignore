# Hardware captures are IRREPLACEABLE and are tracked in git.
# A capture of a real arm at a real moment cannot be regenerated, and a
# capture deleted before it was committed is simply gone -- which happened
# once (provocation_wrist_20261006_133005). Only regenerable data is ignored.
data/sim_*.csv
data/sim_*.png
data/synth_*.csv
data/synth_*.png
data/_*.csv
data/_*.png
data/results.csv

# Build output
firmware/**/build/
*.elf
*.bin

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Phone videos of the cuff gauge are large; keep them out of git. The
# readings extracted from them (data/*_gauge.csv) ARE tracked (D29).
data/video/*
!data/video/.keep
*.mp4
*.mov
*.MOV
*.MP4

# Per-machine convenience: last trial info typed into hr_monitor (D42).
host/.last_trial_info.json

# IRB human-subject recordings never go into git (irb/DESIGN.md section 6).
irb_data/

# Expo board Wi-Fi password (expo/README.md). Only secrets.example.h is tracked.
expo/firmware/*/secrets.h
expo/firmware/**/build/

# Expo results and team dry-run captures (expo/host/expo_results.py). Anonymous, but
# session data, not source.
expo/results/
